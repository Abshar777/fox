# ── Market Notes (blog) ──────────────────────────────────────
# Reads fall back to the bundled starter notes in lib/posts.js when
# MONGODB_URI is unset, so the site runs without any of this. Writing
# from /admin requires all four.

# MongoDB connection string.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Database name. Defaults to "wolfpack" when omitted.
MONGODB_DB="wolfpack"

# Single shared password for /admin.
ADMIN_PASSWORD="change-me"

# Signs the admin session cookie. Use a long random string —
# rotating it signs everyone out. Must be at least 16 characters.
AUTH_SECRET="replace-me-with-a-long-random-string"
